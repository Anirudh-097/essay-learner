# Copy this file to .env for local development. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Single-user authentication. Generate AUTH_PASSWORD_HASH with:
# python -m backend.auth
AUTH_USERNAME=your-username
AUTH_PASSWORD_HASH=
# Use a long random value; this signs the HttpOnly session cookie.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_DAYS=7
# Set true when the backend is served over HTTPS.
AUTH_COOKIE_SECURE=false
